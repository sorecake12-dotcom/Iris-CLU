# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.spec

# ─── Virtual Environments ────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Distribution / Packaging ────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
wheels/

# ─── IRIS AI Runtime Artifacts ───────────────────────────────────
# Logs and generated install files
iris_install.log
iris_debug.log
*.log
logs/

# Cache directories
cache/
.iris/

# Temp audio files generated during TTS synthesis
temp/
temp_*.mp3
temp_*.wav
test_*.mp3
test_*.wav

# Application index cache written by ApplicationDiscoveryService
.iris_app_index.json

# ─── Environment & Secrets ───────────────────────────────────────
# NEVER commit API keys or secrets — only .env.example goes to GitHub

# Environment files
.env
.env.*
!.env.example

# Local API key and user configuration — NEVER commit this
config/config.json
config/*.json

# Voice cache generated at runtime
voice_cache/

# ─── Voice Files ─────────────────────────────────────────────────
# Exclude actual audio reference files from the repo
# (users provide their own voice samples)
voice/*.wav
voice/*.mp3
voice/*.flac
voice/*.ogg
# Keep the README so the directory is tracked
!voice/README.txt

# ─── IDE & Editor ────────────────────────────────────────────────
.cursor/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── OS Generated ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Windows Shortcuts ───────────────────────────────────────────
# Keep the bat launcher out of git (it's generated by install)
iris_run.bat
